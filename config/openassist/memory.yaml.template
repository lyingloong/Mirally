# Copy to memory.yaml and enable after choosing the source/profile.
# This service never starts desktop collection. Models and credentials remain
# managed by OpenClaw; no provider credentials belong in this file.
enabled: false
activity_config_path: config/openassist/activity.yaml
storage:
  # Defaults to the user's local Mirally memory directory, separate from the
  # rebuildable Activity knowledge index. Use absolute paths for custom data.
  database_path: null
  projection_database_path: null
poll_interval_seconds: 2
batch_size: 200
window_seconds: 300
working_ttl_seconds: 86400
context_token_budget: 1000
semantics:
  enabled: false
  model: null # The configured agent's model when omitted.
  agent_id: main
  interval_seconds: 30
  max_calls_per_hour: 6
  max_tokens_per_day: 60000
  max_output_tokens: 1500
