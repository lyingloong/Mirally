# Copy to memory.yaml to customize the default local organization profile.
# This service never starts desktop collection. Models and credentials remain
# managed by OpenClaw; no provider credentials belong in this file.
enabled: true
activity_config_path: config/mirally/activity.yaml
storage:
  # Defaults to the user's local Mirally memory directory, separate from the
  # rebuildable Activity knowledge index. Relative paths use the repository
  # root; absolute paths select a fixed external data location.
  database_path: null
  projection_database_path: null
poll_interval_seconds: 2
batch_size: 200
window_seconds: 300
working_ttl_seconds: 86400
context_token_budget: 1000
raw_retention:
  # Runs only while Memory is enabled. Only a complete, durable semantic
  # receipt authorizes deleting raw observations, screenshots and full text.
  # The first cleanup is scheduled one interval after first maintenance.
  enabled: true
  interval_seconds: 3600
semantics:
  enabled: false
  model: null # The configured agent's model when omitted.
  agent_id: main
  interval_seconds: 30
  max_calls_per_hour: 24
  max_tokens_per_day: 60000
  max_output_tokens: 1500
  max_input_bytes: 24000 # Complete fields are split into bounded model inputs.
