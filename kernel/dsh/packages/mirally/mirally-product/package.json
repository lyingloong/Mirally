{
  "name": "@mirally/dsh-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirally native Agent host, authenticated product API and Python domain supervision",
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
