      "to": "reject-requirement",
      "on": "reject"
    },
    {
      "from": "approve-requirement",
      "to": "prepare",
      "on": "ready"
    },
    {
      "from": "reject-requirement",
      "to": "analyst-revise",
      "on": "revise"
    },
    {
      "from": "analyst-revise",
      "to": "revise-proposal",
      "on": "complete"
    },
    {
      "from": "revise-proposal",
      "to": "route",
      "on": "complete"
    },
    {
      "from": "prepare",
      "to": "begin-engineering",
      "on": "complete"
    },
    {
      "from": "begin-engineering",
      "to": "engineer",
      "on": "complete"
    },
    {
      "from": "engineer",
      "to": "snapshot",
      "on": "complete"
    },
    {
      "from": "snapshot",
      "to": "review-input",
      "on": "complete"
    },
    {
      "from": "review-input",
      "to": "reviewer",
      "on": "complete"
    },
    {
      "from": "reviewer",
      "to": "record-review",
      "on": "pass"
    },
    {
      "from": "reviewer",
      "to": "record-review",
      "on": "revise"
    },
    {
      "from": "record-review",
      "to": "begin-engineering",
      "on": "revise"
    },
    {
      "from": "record-review",
      "to": "merge-human",
      "on": "pass"
    },
    {
      "from": "merge-human",
      "to": "approve-merge",
      "on": "approve"
    },
    {
      "from": "merge-human",
      "to": "request-changes",
      "on": "revise"
    },
    {
      "from": "merge-human",
      "to": "reject-merge",
      "on": "reject"
    },
    {
