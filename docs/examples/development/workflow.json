    },
    {
      "from": "integrate",
      "to": "begin-engineering",
      "on": "revise"
    },
    {
      "from": "dispatch",
      "to": "busy-dispatch",
      "on": "busy"
    },
    {
      "from": "busy-dispatch",
      "to": "dispatch",
      "on": "complete"
    },
    {
      "from": "queue-check",
      "to": "busy-queue-check",
      "on": "busy"
    },
    {
      "from": "busy-queue-check",
      "to": "queue-check",
      "on": "complete"
    },
    {
      "from": "seed-batch",
      "to": "busy-seed-batch",
      "on": "busy"
    },
    {
      "from": "busy-seed-batch",
      "to": "seed-batch",
      "on": "complete"
    },
    {
      "from": "producer-dispatch",
      "to": "busy-producer-dispatch",
      "on": "busy"
    },
    {
      "from": "busy-producer-dispatch",
      "to": "producer-dispatch",
      "on": "complete"
    },
    {
      "from": "record-proposal",
      "to": "busy-record-proposal",
      "on": "busy"
    },
    {
      "from": "busy-record-proposal",
      "to": "record-proposal",
      "on": "complete"
    },
    {
      "from": "route",
      "to": "busy-route",
      "on": "busy"
    },
    {
      "from": "busy-route",
      "to": "route",
      "on": "complete"
    },
    {
      "from": "approve-requirement",
      "to": "busy-approve-requirement",
      "on": "busy"
    },
    {
      "from": "busy-approve-requirement",
      "to": "approve-requirement",
      "on": "complete"
    },
    {
      "from": "reject-requirement",
      "to": "busy-reject-requirement",
      "on": "busy"
    },
    {
      "from": "busy-reject-requirement",
      "to": "reject-requirement",
      "on": "complete"
    },
    {
      "from": "revise-proposal",
      "to": "busy-revise-proposal",
      "on": "busy"
    },
    {
      "from": "busy-revise-proposal",
      "to": "revise-proposal",
      "on": "complete"
    },
    {
      "from": "prepare",
      "to": "busy-prepare",
      "on": "busy"
    },
    {
      "from": "busy-prepare",
      "to": "prepare",
      "on": "complete"
    },
    {
      "from": "begin-engineering",
      "to": "busy-begin-engineering",
      "on": "busy"
    },
    {
      "from": "busy-begin-engineering",
      "to": "begin-engineering",
      "on": "complete"
    },
    {
      "from": "snapshot",
      "to": "busy-snapshot",
      "on": "busy"
    },
    {
      "from": "busy-snapshot",
      "to": "snapshot",
      "on": "complete"
