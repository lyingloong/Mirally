      "on": "ready"
    },
    {
      "from": "seed-batch",
      "to": "producer-dispatch",
      "on": "idle"
    },
    {
      "from": "seed-fanout",
      "to": "producer-dispatch",
      "on": "complete"
    },
    {
      "from": "producer-dispatch",
      "to": "producer-work",
      "on": "ready"
    },
    {
      "from": "producer-dispatch",
      "to": "mine-gate",
