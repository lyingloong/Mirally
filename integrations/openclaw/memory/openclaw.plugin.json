{
  "id": "mirally-memory",
  "name": "Mirally Memory",
  "description": "Continuously maintains evidence-backed memory and recalls bounded context for OpenClaw.",
  "version": "0.1.0",
  "categories": ["productivity"],
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["configPath"],
    "properties": {
      "root": { "type": "string" },
      "configPath": { "type": "string", "minLength": 1 },
      "queryTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 2500 },
      "contextTokenBudget": { "type": "integer", "minimum": 128, "maximum": 2000, "default": 1000 },
      "autoRecall": { "type": "boolean", "default": true }
    }
  }
}
