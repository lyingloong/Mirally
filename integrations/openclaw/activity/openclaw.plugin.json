{
  "id": "mirally-activity",
  "name": "Mirally Activity Knowledge",
  "description": "On-demand activity knowledge lookup shared by OpenClaw agents.",
  "version": "0.1.0",
  "categories": ["productivity"],
  "activation": { "onStartup": true },
  "contracts": {
    "tools": [
      "activity_health",
      "activity_recent",
      "activity_search",
      "activity_around",
      "activity_summary",
      "activity_query",
      "activity_events",
      "activity_episode",
      "activity_evidence"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "root": { "type": "string", "description": "Mirally repository root." },
      "configPath": { "type": "string", "description": "Optional activity.yaml path." },
      "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 }
    }
  }
}
